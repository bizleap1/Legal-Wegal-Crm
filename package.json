{
  "name": "lead-management-crm",
  "version": "1.0.0",
  "description": "Enterprise Lead Management CRM with Meta Ads, WhatsApp, Website Forms & Google Ads attribution",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WORKER,WEB\" -c \"blue,magenta,cyan\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:api": "npm run --workspace=@crm/api dev",
    "dev:worker": "npm run --workspace=@crm/worker dev",
    "dev:web": "npm run --workspace=@crm/web dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run --workspace=@crm/database generate",
    "db:seed": "npm run --workspace=@crm/database seed",
    "db:push": "npm run --workspace=@crm/database push"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "deepmerge-ts": "^8.0.2"
  }
}
